# Every value below is a fixture, not a real secret.
SECRET_KEY=fixture-0123456789abcdefghijklmnopqrstuvwxyzABCD
INIT_PASSWORD=fixture-init-password
DEBUG=false
ENABLE_REQUEST_LOGGING=false
DB_PASSWORD=fixture-db-password
REDIS_PASSWORD=fixture-redis-password
CELERY_BROKER_URL=redis://:fixture-redis-password@redis:6379/1
WEB_API_CORS_ALLOW_ORIGINS=https://dify.example.com
CONSOLE_CORS_ALLOW_ORIGINS=https://dify.example.com
VECTOR_STORE=weaviate
WEAVIATE_API_KEY=fixture-weaviate-key
WEAVIATE_AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=false
WEAVIATE_AUTHENTICATION_APIKEY_ALLOWED_KEYS=fixture-weaviate-key
CODE_EXECUTION_API_KEY=fixture-sandbox-key
SANDBOX_API_KEY=fixture-sandbox-key
SSRF_PROXY_HTTP_URL=http://ssrf_proxy:3128
SSRF_PROXY_HTTPS_URL=http://ssrf_proxy:3128
PLUGIN_DAEMON_KEY=fixture-daemon-key
PLUGIN_DIFY_INNER_API_KEY=fixture-inner-key
DIFY_AGENT_API_TOKEN=fixture-agent-token
DIFY_AGENT_SERVER_SECRET_KEY=fixture-agent-secret
NGINX_HTTPS_ENABLED=true
COMPOSE_PROFILES=weaviate,postgresql
